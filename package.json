{
    "name": "eslint-plugin-comments",
    "version": "1.0.0",
    "description": "Eslint rules for JavaScript comments.",
    "main": "index.js",
    "scripts": {
        "pretest": "eslint .",
        "test": "npm run test:unit --coverage && npm run check-coverage",
        "test:unit": "istanbul test _mocha test -- --recursive --reporter dot",
        "check-coverage": "istanbul check-coverage --statement 100 --branch 100 --function 100 --lines 100",
        "coveralls": "cat ./build/coverage/lcov.info | coveralls",
        "changelog": "pr-log --default-branch master"
    },
    "dependencies": {
        "doctrine": "0.6.4"
    },
    "devDependencies": {
        "chai": "3.2.0",
        "pr-log": "6.5.0",
        "istanbul": "0.3.20",
        "mocha": "2.3.2",
        "eslint": "1.4.1",
        "coveralls": "2.11.4"
    },
    "peerDependencies": {
        "eslint": "^1.4.1"
    },
    "files": [
        "index.js",
        "lib/"
    ],
    "repository": {
        "type": "git",
        "url": "git://github.com/lo1tuma/eslint-plugin-comments.git"
    },
    "author": "Mathias Schreck <schreck.mathias@gmail.com>",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/lo1tuma/eslint-plugin-comments/issues"
    },
    "homepage": "https://github.com/lo1tuma/eslint-plugin-comments",
    "keywords": [
        "eslint",
        "eslintplugin",
        "eslint-plugin",
        "comments",
        "jsdoc"
    ],
    "pr-log": {
        "collapseRules": [
            {
                "label": "upgrade",
                "pattern": "^(?<prefix>⬆️ )?Update dependency (?<dependency>.+?) from (?<from>.+?) to (?<to>.+?)$",
                "replace": "$<prefix>Update dependency $<dependency> from $<from> to $<to>"
            },
            {
                "label": "upgrade",
                "pattern": "^(?<prefix>⬆️ )?Update (?:dependency )?`?(?<dependency>.+?)`? to `?(?<to>[^` ]+)`?$",
                "replace": "$<prefix>Update dependency $<dependency> to $<to>",
                "versionGroup": "to"
            },
            {
                "label": "upgrade",
                "pattern": "^(?<prefix>⬆️ )?(?<dependency>Lock file maintenance|Update (?:.+ dependencies|eslint))$",
                "replace": "$<prefix>$<dependency>",
                "collapse": "same"
            }
        ]
    }
}
